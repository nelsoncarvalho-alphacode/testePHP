## Configurações do banco de dados

# Aqui você coloca o host do banco de dados como foi configurado no Dockerfile (db)
DB_HOST=

# Aqui você coloca o nome do banco de dados (testephp)
DB_NAME=

# Aqui você coloca o usuário do banco de dados (root)
DB_USER=

# Aqui você coloca a senha do banco de dados (como é um arquivo de exemplo, irei dizer a senha, que seria: phpteste)
DB_PASS=